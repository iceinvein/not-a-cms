---
import { renderTextChildren } from "../../runtime/block-renderer"
const { block } = Astro.props
const level = block.level || 1
const html = renderTextChildren(block.children || [])
---
{level === 1 && <h1 class="text-3xl font-bold mt-8 mb-4" set:html={html} />}
{level === 2 && <h2 class="text-2xl font-bold mt-6 mb-3" set:html={html} />}
{level === 3 && <h3 class="text-xl font-semibold mt-5 mb-2" set:html={html} />}
{level === 4 && <h4 class="text-lg font-semibold mt-4 mb-2" set:html={html} />}
{level === 5 && <h5 class="text-base font-semibold mt-3 mb-1" set:html={html} />}
{level === 6 && <h6 class="text-sm font-semibold mt-3 mb-1" set:html={html} />}
