---
import DefaultLayout from "../defaults/layouts/default.astro"
---
<DefaultLayout title="Page Not Found">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
    <p class="text-xl text-gray-600 mb-8">This page doesn't exist.</p>
    <a href="/" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors">
      Back to home
    </a>
  </div>
</DefaultLayout>
