---
import DefaultLayout from "../../defaults/layouts/default.astro"
import { renderDocumentContent } from "../../runtime/document-renderer"

const { token } = Astro.params
const apiBase = import.meta.env.PUBLIC_API_BASE || "http://localhost:4321"
const collection = Astro.url.searchParams.get("collection")
const documentId = Astro.url.searchParams.get("documentId")

let post = null
let error = null

try {
  const params = new URLSearchParams()
  if (collection) params.set("collection", collection)
  if (documentId) params.set("documentId", documentId)
  const query = params.toString()
  const res = await fetch(`${apiBase}/api/_preview/validate/${token}${query ? `?${query}` : ""}`)
  if (res.ok) {
    post = await res.json()
  } else {
    const data = await res.json().catch(() => ({ error: "Invalid preview link" }))
    error = data.error || "Invalid or expired preview link"
  }
} catch {
  error = "Failed to load preview"
}

const rendered = post ? renderDocumentContent(post) : { html: "", leadsWithHero: false }
---
<DefaultLayout title={post ? `Preview: ${post.title}` : "Preview"}>
  {error ? (
    <div class="text-center py-20">
      <p class="text-xl text-gray-600 mb-4">{error}</p>
      <a href="/" class="text-blue-600 hover:underline">Back to home</a>
    </div>
  ) : post ? (
    <div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-2 mb-8 text-sm text-yellow-800">
        This is a preview. This content has not been published yet.
      </div>
      <article class="prose prose-gray max-w-none">
        {!rendered.leadsWithHero && <h1>{post.title}</h1>}
        <Fragment set:html={rendered.html} />
      </article>
    </div>
  ) : null}
</DefaultLayout>
