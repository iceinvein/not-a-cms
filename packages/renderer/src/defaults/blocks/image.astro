---
const { block } = Astro.props
const alt = block.alt || ""
const caption = block.caption || ""
const src = block.src || block.url || ""
---
<figure class="my-6">
  {src && <img src={src} alt={alt} class="rounded-lg w-full" loading="lazy" />}
  {caption && <figcaption class="text-sm text-gray-500 mt-2 text-center">{caption}</figcaption>}
</figure>
