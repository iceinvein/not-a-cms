---
interface Props {
  collections?: Array<{ name: string; label?: string; labels?: { singular: string; plural: string } }>
  currentPath: string
}

const { collections = [], currentPath } = Astro.props

function isActive(href: string) {
  if (href === "/") return currentPath === "/"
  return currentPath === href || currentPath.startsWith(href)
}

function linkClass(href: string) {
  const active = isActive(href)
  return [
    "sidebar-link flex items-center gap-2.5 px-3 py-1.5 rounded-md text-sm transition-colors",
    active
      ? "bg-[rgba(255,255,255,0.08)] text-[#fafafa] font-medium"
      : "text-[#71717a] hover:text-[#a1a1aa] hover:bg-[rgba(255,255,255,0.03)]",
  ].join(" ")
}
---

<aside
  id="sidebar"
  data-expanded="true"
  class="w-[190px] bg-[#111113] border-r border-[rgba(255,255,255,0.06)] min-h-screen flex flex-col flex-shrink-0 transition-all duration-200 overflow-hidden"
  style="width: 190px;"
>
  <!-- Header -->
  <div class="flex items-center gap-2 px-3 py-4 border-b border-[rgba(255,255,255,0.06)]">
    <div class="w-6 h-6 bg-[#fafafa] rounded flex items-center justify-center flex-shrink-0">
      <span class="text-[#0a0a0c] text-xs font-bold leading-none">N</span>
    </div>
    <span id="sidebar-label" class="text-sm font-semibold text-[#fafafa] truncate flex-1">not-a-cms</span>
    <button
      id="sidebar-toggle"
      class="flex-shrink-0 text-[#52525b] hover:text-[#a1a1aa] transition-colors"
      aria-label="Toggle sidebar"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>
  </div>

  <!-- Search hint -->
  <div id="sidebar-search" class="px-3 py-2">
    <div class="flex items-center gap-2 px-2 py-1.5 rounded-md bg-[rgba(255,255,255,0.05)] text-[#52525b] cursor-pointer hover:bg-[rgba(255,255,255,0.08)] transition-colors">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <span class="sidebar-text text-xs flex-1">Search</span>
      <span class="sidebar-text text-xs text-[#3f3f46]">⌘K</span>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="flex-1 px-3 py-1 space-y-0.5">
    <!-- Dashboard -->
    <a href="/" class={linkClass("/")}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
      </svg>
      <span class="sidebar-text truncate">Dashboard</span>
    </a>

    <!-- Collections -->
    {collections.map(c => {
      const href = `/content/${c.name}`
      const label = c.labels?.plural ?? c.label ?? c.name
      return (
        <a href={href} class={linkClass(href)}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
            <path d="M14 2v6h6"/>
          </svg>
          <span class="sidebar-text truncate">{label}</span>
        </a>
      )
    })}

    <!-- Media -->
    <a href="/media" class={linkClass("/media")}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <circle cx="9" cy="9" r="2"/>
        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
      </svg>
      <span class="sidebar-text truncate">Media</span>
    </a>
  </nav>

  <!-- Bottom nav -->
  <div class="px-3 py-2 border-t border-[rgba(255,255,255,0.06)] space-y-0.5">
    <a href="/automations" class={linkClass("/automations")}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <path d="M7 7h.01"/>
        <path d="M17 7h.01"/>
        <path d="M7 17h.01"/>
        <path d="M17 17h.01"/>
      </svg>
      <span class="sidebar-text truncate">Automations</span>
    </a>
    <a href="/webhooks" class={linkClass("/webhooks")}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
        <path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"/>
        <path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"/>
        <path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 .8 7.93"/>
      </svg>
      <span class="sidebar-text truncate">Webhooks</span>
    </a>
    <a href="/settings" class={linkClass("/settings")}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-icon flex-shrink-0">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <span class="sidebar-text truncate">Settings</span>
    </a>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar') as HTMLElement
  const toggle = document.getElementById('sidebar-toggle') as HTMLElement
  const isCollapsed = localStorage.getItem('nacms-sidebar-collapsed') === 'true'

  function collapse() {
    sidebar.style.width = '48px'
    sidebar.dataset.expanded = 'false'
    sidebar.querySelectorAll('.sidebar-text').forEach((el: Element) => (el as HTMLElement).style.display = 'none')
    const label = document.getElementById('sidebar-label')
    const search = document.getElementById('sidebar-search')
    if (label) label.style.display = 'none'
    if (search) search.style.display = 'none'
    const chevron = toggle.querySelector('svg')
    if (chevron) chevron.style.transform = 'rotate(180deg)'
    localStorage.setItem('nacms-sidebar-collapsed', 'true')
  }

  function expand() {
    sidebar.style.width = '190px'
    sidebar.dataset.expanded = 'true'
    sidebar.querySelectorAll('.sidebar-text').forEach((el: Element) => (el as HTMLElement).style.display = '')
    const label = document.getElementById('sidebar-label')
    const search = document.getElementById('sidebar-search')
    if (label) label.style.display = ''
    if (search) search.style.display = ''
    const chevron = toggle.querySelector('svg')
    if (chevron) chevron.style.transform = ''
    localStorage.setItem('nacms-sidebar-collapsed', 'false')
  }

  if (isCollapsed) collapse()
  toggle.addEventListener('click', () => {
    if (sidebar.dataset.expanded === 'true') collapse()
    else expand()
  })
</script>
