---
interface Props {
  collections?: Array<{ name: string; label?: string; labels?: { singular: string; plural: string } }>
  currentPath: string
}

const { collections = [], currentPath } = Astro.props

const navItems = [
  { href: "/", label: "Dashboard", icon: "📊" },
  ...collections.map(c => ({
    href: `/content/${c.name}`,
    label: c.labels?.plural ?? c.label ?? c.name,
    icon: "📄",
  })),
  { href: "/media", label: "Media", icon: "🖼️" },
]
---

<aside class="w-64 bg-white border-r border-gray-200 min-h-screen flex flex-col">
  <div class="p-4 border-b border-gray-200">
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">N</div>
      <span class="font-semibold text-gray-900">not-a-cms</span>
    </a>
  </div>

  <nav class="flex-1 p-3">
    <ul class="space-y-1">
      {navItems.map(item => {
        const isActive = currentPath === item.href ||
          (item.href !== "/" && currentPath.startsWith(item.href))
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors",
                isActive
                  ? "bg-blue-50 text-blue-700 font-medium"
                  : "text-gray-600 hover:bg-gray-50 hover:text-gray-900",
              ]}
            >
              <span>{item.icon}</span>
              <span>{item.label}</span>
            </a>
          </li>
        )
      })}
    </ul>
  </nav>

  <div class="p-3 border-t border-gray-200">
    <a href="/settings" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-50">
      <span>⚙️</span>
      <span>Settings</span>
    </a>
  </div>
</aside>
