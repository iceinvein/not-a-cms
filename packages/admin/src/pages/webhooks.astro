---
import { WebhookManager } from "../components/WebhookManager"
import AdminLayout from "../layouts/AdminLayout.astro"
import { getAdminApiBase } from "../lib/api"

const apiBase = getAdminApiBase()
---
<AdminLayout title="Webhooks">
  <p class="text-sm text-[#838389] mb-8">Configure outbound webhooks for content lifecycle events.</p>
  <WebhookManager client:load apiBase={apiBase} />
</AdminLayout>
