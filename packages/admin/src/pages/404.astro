---
import "../styles/global.css"
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Not Found — not-a-cms</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#0a0a0c] text-[#a1a1aa] min-h-screen flex items-center justify-center" style="font-family: 'Inter', system-ui, -apple-system, sans-serif;">
  <div class="text-center">
    <div class="w-10 h-10 bg-[#c6ff3d] rounded-lg flex items-center justify-center mx-auto mb-6">
      <span class="text-[#0a0a0c] text-sm font-bold">N</span>
    </div>
    <h1 class="text-xl font-semibold text-[#fafafa] mb-2">Page not found</h1>
    <p class="text-sm text-[#838389] mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-[#c6ff3d] text-[#0a0a0c] rounded-md text-sm font-medium hover:bg-[#d4ff6e] transition-colors">
      Back to Dashboard
    </a>
  </div>
</body>
</html>
