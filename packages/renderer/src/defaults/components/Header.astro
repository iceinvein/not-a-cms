---
import type { SiteNav } from "../../runtime/site-chrome"

interface Props {
  siteName?: string
  nav?: SiteNav | null
}
const { siteName = "not-a-cms", nav = null } = Astro.props
---
<header class="nac-header border-b border-[var(--border)] bg-[var(--paper)]">
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-semibold text-[var(--ink)] [font-family:var(--font-display)] tracking-tight">{siteName}</a>
    {(nav?.links?.length || nav?.cta) && (
      <nav class="nac-nav flex items-center gap-6">
        {nav?.links?.map(item => (
          <a
            href={item.href}
            class="text-sm text-[var(--muted)] hover:text-[var(--accent)] transition-colors"
            {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >{item.label}</a>
        ))}
        {nav?.cta && (
          <a
            class="nac-cta-btn"
            data-variant="primary"
            href={nav.cta.href}
          >{nav.cta.label}</a>
        )}
      </nav>
    )}
  </div>
</header>
