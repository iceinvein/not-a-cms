---
import { renderSiteChrome, type SiteNav } from "../../runtime/site-chrome-html"

interface Props {
  siteName?: string
  nav?: SiteNav | null
}
const { siteName = "not-a-cms", nav = null } = Astro.props
const { header } = renderSiteChrome({ siteName, nav, footer: null })
---
<Fragment set:html={header} />

<script is:inline>
(function () {
  var header = document.querySelector(".nac-header");
  var toggle = header && header.querySelector(".nac-nav-toggle");
  var mobileNav = header && header.querySelector(".nac-mobile-nav");
  if (!toggle || !mobileNav) return;

  function openMenu() {
    header.setAttribute("data-open", "");
    toggle.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    header.removeAttribute("data-open");
    toggle.setAttribute("aria-expanded", "false");
  }

  toggle.addEventListener("click", function () {
    if (header.hasAttribute("data-open")) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close when any link in the mobile nav is clicked.
  var links = mobileNav.querySelectorAll("a");
  links.forEach(function (link) {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape key.
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && header.hasAttribute("data-open")) {
      closeMenu();
      toggle.focus();
    }
  });
})();
</script>
