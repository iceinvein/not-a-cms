---
import { renderSiteChrome, type SiteFooter } from "../../runtime/site-chrome-html"

interface Props {
  siteName?: string
  footer?: SiteFooter | null
}
const { siteName = "not-a-cms", footer = null } = Astro.props
const { footer: footerHtml } = renderSiteChrome({ siteName, nav: null, footer })
---
<Fragment set:html={footerHtml} />
