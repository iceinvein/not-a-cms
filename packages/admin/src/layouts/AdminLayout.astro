---
import Sidebar from "../components/Sidebar.astro"
import { adminApiUrl } from "../lib/api"
import { fetchCollections } from "../lib/schema"
import "../styles/global.css"

interface Props {
  title: string
  extensionNavItems?: Array<{
    label: string
    href: string
    section?: "main" | "bottom"
    icon?: string
  }>
}

const { title, extensionNavItems = [] } = Astro.props
const currentPath = Astro.url.pathname
const cookie = Astro.request.headers.get("cookie") || ""

// Auth check — skip for login and auth callback pages
const isAuthPage = currentPath === "/login" || currentPath.startsWith("/auth/")
if (!isAuthPage) {
  try {
    const sessionRes = await fetch(adminApiUrl("/api/auth/get-session"), {
      headers: { cookie },
    })
    if (sessionRes.ok) {
      const session = await sessionRes.json()
      if (!session?.user) {
        return Astro.redirect("/login")
      }
    } else {
      return Astro.redirect("/login")
    }
  } catch {
    // API unreachable (e.g. admin started before API) — allow access in dev
    if (import.meta.env.PROD) {
      return Astro.redirect("/login")
    }
  }
}

const collections = await fetchCollections({ cookie })
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — not-a-cms</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    if (window.localStorage.getItem('nacms-sidebar-collapsed') === 'true') {
      document.documentElement.classList.add('sidebar-collapsed')
    }
  </script>
</head>
<body class="bg-[#0a0a0c] text-[#a1a1aa] min-h-screen" style="font-family: 'Inter', system-ui, -apple-system, sans-serif;">
  <div class="flex min-h-screen">
    <Sidebar collections={collections} currentPath={currentPath} extensionNavItems={extensionNavItems} />
    <main class="flex-1 min-h-screen">
      <header class="px-8 pt-8 pb-2">
        <h1 class="text-xl font-semibold text-[#fafafa] tracking-[-0.01em]">{title}</h1>
      </header>
      <div class="px-8 pb-8">
        <slot />
      </div>
    </main>
  </div>
</body>
</html>
