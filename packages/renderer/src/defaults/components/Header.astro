---
interface Props {
  siteName?: string
  navItems?: Array<{ label: string; href: string }>
}
const { siteName = "not-a-cms", navItems = [] } = Astro.props
---
<header class="border-b border-[var(--border)] bg-[var(--paper)]">
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-semibold text-[var(--ink)] [font-family:var(--font-display)] tracking-tight">{siteName}</a>
    {navItems.length > 0 && (
      <nav class="flex gap-6">
        {navItems.map(item => (
          <a href={item.href} class="text-sm text-[var(--muted)] hover:text-[var(--accent)] transition-colors">{item.label}</a>
        ))}
      </nav>
    )}
  </div>
</header>
