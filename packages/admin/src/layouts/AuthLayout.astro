---
import "../styles/fonts"
import "../styles/global.css"

interface Props {
  title: string
}
const { title } = Astro.props
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · not-a-cms</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-[#0a0a0c] text-[#a1a1aa] min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center gap-2 mb-6">
      <div class="w-10 h-10 bg-[#c6ff3d] rounded-lg flex items-center justify-center">
        <span class="text-[#0a0a0c] text-lg font-bold leading-none">N</span>
      </div>
      <span class="text-base font-semibold text-[#fafafa]">not-a-cms</span>
    </div>
    <div class="bg-[#18181b] rounded-lg border border-[rgba(255,255,255,0.06)] p-8">
      <slot />
    </div>
  </div>
</body>
</html>
