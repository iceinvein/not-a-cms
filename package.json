{
  "name": "not-a-cms",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": ["packages/*", "dogfood-sites/*"],
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^9.5.5",
    "@types/bun": "latest",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --hot packages/server/src/dev.ts",
    "dev:admin": "cd packages/admin && bunx astro dev --port 4322",
    "test": "turbo run test",
    "test:e2e": "bun tests/e2e/agent-browser-e2e.ts",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  }
}
