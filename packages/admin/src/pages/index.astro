---
import AdminLayout from "../layouts/AdminLayout.astro"
import { Desk } from "../components/desk/Desk"
import { getAdminApiBase } from "../lib/api"
import { fetchCollections } from "../lib/schema"

const collections = await fetchCollections({ cookie: Astro.request.headers.get("cookie") || "" })
const apiBase = getAdminApiBase()
---
<AdminLayout title="Home">
  <div class="space-y-12">
    <Desk client:load apiBase={apiBase} />

    {collections.length > 0 && (
      <section>
        <h2 class="text-sm font-medium text-[#71717a] uppercase tracking-wider mb-5">Quick Actions</h2>
        <div class="flex gap-3">
          {collections.map(c => (
            <a
              href={`/content/${c.name}/new`}
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#c9956b] text-[#0a0a0c] rounded-md text-sm font-medium hover:bg-[#d4a57c] transition-colors"
            >
              + New {c.labels.singular}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</AdminLayout>
