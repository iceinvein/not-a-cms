{
  "name": "@not-a-cms/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./config": "./src/config.ts",
    "./rest": "./src/rest/index.ts",
    "./trpc": "./src/trpc/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun --hot src/dev.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.5.0",
    "@not-a-cms/core": "workspace:*",
    "@pothos/core": "^4.12.0",
    "@trpc/client": "11.17.0",
    "@trpc/server": "11.17.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.40.0",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.0",
    "sharp": "^0.34.5",
    "yjs": "^13.6.30",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
