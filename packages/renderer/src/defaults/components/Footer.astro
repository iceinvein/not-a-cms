---
interface Props {
  siteName?: string
}
const { siteName = "not-a-cms" } = Astro.props
---
<footer class="border-t border-gray-200 mt-16">
  <div class="max-w-4xl mx-auto px-4 py-8 text-center text-sm text-gray-400">
    <p>&copy; {new Date().getFullYear()} {siteName}. Powered by not-a-cms.</p>
  </div>
</footer>
