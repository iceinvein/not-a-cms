---
import { Continuum } from "../../../components/continuum/Continuum"
import AdminLayout from "../../../layouts/AdminLayout.astro"
import { getAdminApiBase } from "../../../lib/api"
import { fetchCollection } from "../../../lib/schema"

const { collection, id } = Astro.params
const schema = await fetchCollection(collection!, {
  cookie: Astro.request.headers.get("cookie") || "",
})

if (!schema) return Astro.redirect("/")

const label = schema.labels.singular
const apiBase = getAdminApiBase()
const siteBase = import.meta.env.PUBLIC_SITE_BASE || "http://localhost:3000"
---
<AdminLayout title={`Edit ${label}`}>
  <Continuum
    client:load
    collection={collection!}
    collectionLabel={label}
    fields={schema.fields}
    documentId={id}
    apiBase={apiBase}
    siteBase={siteBase}
  />
</AdminLayout>
