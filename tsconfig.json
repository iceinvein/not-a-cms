{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["bun"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist",
    "packages/*/.astro",
    "packages/*/.turbo",
    "packages/*/test",
    "tests",
    "dogfood-output",
    "uploads"
  ]
}
