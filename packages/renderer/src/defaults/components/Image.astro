---
type Props = {
  src: string
  alt: string
  width?: number
  height?: number
  blurDataURL?: string
  variants?: Array<{ width: number; format: string; path: string }>
  class?: string
}

const { src, alt, width, height, blurDataURL, variants, class: className } = Astro.props

const sourceWidths = [640, 768, 1024, 1280, 1536].filter((candidate) => !width || candidate <= width)
const canBuildMediaVariantUrls = /^\/api\/media\/[^/]+\/file$/.test(src)

const generatedVariants = canBuildMediaVariantUrls
  ? sourceWidths.flatMap((sourceWidth) => [
    { width: sourceWidth, format: "avif", path: `${src}?w=${sourceWidth}&format=avif` },
    { width: sourceWidth, format: "webp", path: `${src}?w=${sourceWidth}&format=webp` },
  ])
  : []

const responsiveVariants = (variants?.length ? variants : generatedVariants)

const webpVariants = responsiveVariants
  .filter((v) => v.format === "webp")
  .sort((a, b) => a.width - b.width)

const avifVariants = responsiveVariants
  .filter((v) => v.format === "avif")
  .sort((a, b) => a.width - b.width)

const buildSrcset = (vs: typeof webpVariants) =>
  vs.map((v) => `${v.path} ${v.width}w`).join(", ")
---

<picture>
  {avifVariants.length > 0 && (
    <source type="image/avif" srcset={buildSrcset(avifVariants)} sizes="(max-width: 768px) 100vw, 768px" />
  )}
  {webpVariants.length > 0 && (
    <source type="image/webp" srcset={buildSrcset(webpVariants)} sizes="(max-width: 768px) 100vw, 768px" />
  )}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    class={className}
    style={blurDataURL ? `background-image:url(${blurDataURL});background-size:cover` : undefined}
  />
</picture>
