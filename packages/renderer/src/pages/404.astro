---
import DefaultLayout from "../defaults/layouts/default.astro"
---
<DefaultLayout title="Page Not Found">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-[var(--border)] mb-4">404</h1>
    <p class="text-xl text-[var(--body)] mb-8">This page doesn't exist.</p>
    <a href="/" class="inline-flex items-center px-6 py-3 bg-[var(--accent)] text-[var(--accent-ink)] rounded-lg hover:opacity-90 transition-opacity">
      Back to home
    </a>
  </div>
</DefaultLayout>
