---
import AppShell from "../components/shell/AppShell.astro"
import { CommandPalette } from "../components/command/CommandPalette"
import { adminApiUrl, getAdminApiBase } from "../lib/api"
import { fetchCollections } from "../lib/schema"
import "../styles/fonts"
import "../styles/global.css"

interface Props {
  title: string
  extensionNavItems?: Array<{
    label: string
    href: string
    section?: "main" | "bottom"
    icon?: string
  }>
}

const { title, extensionNavItems = [] } = Astro.props
const currentPath = Astro.url.pathname
const cookie = Astro.request.headers.get("cookie") || ""

// Auth check - skip for login and auth callback pages.
const isAuthPage = currentPath === "/login" || currentPath.startsWith("/auth/")
if (!isAuthPage) {
  try {
    const sessionRes = await fetch(adminApiUrl("/api/auth/get-session"), {
      headers: { cookie },
    })
    if (sessionRes.ok) {
      const session = await sessionRes.json()
      if (!session?.user) {
        return Astro.redirect("/login")
      }
    } else {
      return Astro.redirect("/login")
    }
  } catch {
    // API unreachable, such as admin starting before API. Allow access in dev.
    if (import.meta.env.PROD) {
      return Astro.redirect("/login")
    }
  }
}

const collections = await fetchCollections({ cookie })
const apiBase = getAdminApiBase()
const siteBase = import.meta.env.PUBLIC_SITE_BASE || "http://localhost:3000"
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — not-a-cms</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    if (window.localStorage.getItem('nacms-rail-collapsed') === 'true') {
      document.documentElement.classList.add('rail-collapsed')
    }
  </script>
  <script is:inline define:vars={{ apiBase, isAuthPage }}>
    // Client-side auth guard. SSR cannot see the API session cookie in the
    // cross-origin dev setup, so confirm the session in the browser (cookie is
    // sent with credentials) and redirect unauthenticated users to /login.
    if (!isAuthPage) {
      fetch(apiBase + '/api/auth/get-session', { credentials: 'include' })
        .then(function (res) { return res.ok ? res.json() : null })
        .then(function (session) {
          if (!session || !session.user) window.location.replace('/login')
        })
        .catch(function () {})
    }
  </script>
</head>
<body class="bg-[#0a0a0c] text-[#a1a1aa] min-h-screen">
  <AppShell
    title={title}
    currentPath={currentPath}
    collections={collections}
    extensionNavItems={extensionNavItems}
  >
    <slot />
  </AppShell>
  <CommandPalette
    client:load
    apiBase={apiBase}
    siteBase={siteBase}
    collections={collections}
    pathname={currentPath}
  />
</body>
</html>
